# ─── Database ───
DATABASE_URL=mysql://user:password@localhost:3306/smartspend

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# ─── JWT (min 32 chars) ───
JWT_SECRET=

# ─── Gemini AI ───
GEMINI_API_KEY=
GEMINI_MODEL_FREE=gemini-2.0-flash
GEMINI_MODEL_PRO=gemini-2.5-flash
GEMINI_MODEL_REPORTS=gemini-2.5-pro

# ─── App URLs ───
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
# FRONTEND_URL=https://app.your-domain.com

# ─── Owner (optional admin bootstrap) ───
OWNER_EMAIL=

# ─── Paymob (required for real revenue in production) ───
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
# NEVER set true in production:
# BILLING_SIMULATE=false

TRUST_PROXY=true
