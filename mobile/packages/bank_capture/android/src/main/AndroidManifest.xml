<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The notice that asks whether to record a captured bank transaction (Android 13 asks the user first). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Notification access for bank and wallet messages. Only the system can bind it
             (BIND_NOTIFICATION_LISTENER_SERVICE), and only after the user turns it on in Settings.
             No default_filter_types: some banks post silent notifications, so the listener receives every
             type and its own code decides what is a bank message. -->
        <service
            android:name=".BankNotificationListener"
            android:exported="true"
            android:label="SmartSpend"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- A tap on a transaction notice's "record" or "not mine" button; only this app's notices send it. -->
        <receiver
            android:name=".CaptureActionReceiver"
            android:exported="false" />
    </application>
</manifest>
