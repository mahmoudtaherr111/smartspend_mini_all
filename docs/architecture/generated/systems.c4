// The hand-written model sits one folder up: spec.c4, context.c4, views.c4 and flows/.

model {
  capacitor = external 'Capacitor native shell' {
    technology 'native-runtime'
    metadata {
      packages '@capacitor/core, @capacitor/app, @capacitor/haptics, @capacitor/keyboard, @capacitor/splash-screen, @capacitor/status-bar'
    }
  }
  deepseek = external 'DeepSeek API' {
    technology 'ai-provider'
    metadata {
      hosts 'api.deepseek.com'
    }
  }
  firebase = external 'Firebase' {
    technology 'push'
    metadata {
      packages 'firebase-admin, firebase'
    }
  }
  fireworks = external 'Fireworks AI' {
    technology 'ai-provider'
    metadata {
      hosts 'api.fireworks.ai'
    }
  }
  gemini = external 'Google Gemini API' {
    technology 'ai-provider'
    metadata {
      packages '@google/generative-ai'
      hosts 'generativelanguage.googleapis.com'
    }
  }
  google-oauth = external 'Google OAuth 2.0' {
    technology 'identity'
    metadata {
      hosts 'accounts.google.com, oauth2.googleapis.com, www.googleapis.com'
    }
  }
  groq = external 'Groq' {
    technology 'ai-provider'
    metadata {
      packages 'groq-sdk'
      hosts 'api.groq.com'
    }
  }
  nvidia = external 'NVIDIA NIM' {
    technology 'ai-provider'
    metadata {
      hosts 'integrate.api.nvidia.com'
    }
  }
  openrouter = external 'OpenRouter' {
    technology 'ai-provider'
    metadata {
      hosts 'openrouter.ai'
    }
  }
  paymob = external 'Paymob (Accept)' {
    technology 'payments'
    metadata {
      hosts 'accept.paymob.com'
    }
  }
  sentry = external 'Sentry' {
    technology 'observability'
    metadata {
      packages '@sentry/node, @sentry/profiling-node'
    }
  }
  turnstile = external 'Cloudflare Turnstile' {
    technology 'bot-protection'
    metadata {
      hosts 'challenges.cloudflare.com'
    }
  }
  web-push = external 'Web Push' {
    technology 'push'
    metadata {
      packages 'web-push'
    }
  }
  whatsapp = external 'WhatsApp through Baileys' {
    technology 'messaging'
    metadata {
      packages '@whiskeysockets/baileys'
    }
  }

  extend smartspend {
    object-storage = store 'S3-compatible object storage (R2/S3)' {
      technology 'datastore'
    }
    qdrant = store 'Qdrant vector store' {
      technology 'datastore'
    }
    redis = store 'Redis' {
      technology 'datastore'
      metadata {
        packages 'redis'
      }
    }
  }
}
