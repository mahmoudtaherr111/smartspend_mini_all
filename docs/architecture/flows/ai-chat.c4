// Hand-written flow. scripts/knowledge/flows-rules.ts (run by the tests and by npm run agent:finish) fails
// when a step here is not backed by a relationship generated from the code. Write one step per line with full
// element names; end a step the code cannot show (a human action) with `// intent: <why>`.
views {
  dynamic view flow_ai_chat {
    title 'Flow · a question in the AI Center'
    description 'chat.sendMessage stores the message and, while the AI kernel is enabled in settings, runs it. The kernel plans the turn without a model (intent, data needs, a clarifying question when something is missing), resolves the facts through the finance semantic layer, and makes at most one model call to word the answer, whose numbers are then checked against the facts. Actions are drafted as pending and run only after the user confirms them.'

    user -> smartspend.web.pages.AICenter 'asks a question or requests an action' // intent: the person opens the page
    smartspend.web.pages.AICenter -> smartspend.api.trpc.chat.sendMessage 'send the message'
    smartspend.api.trpc.chat.sendMessage -> smartspend.mysql.chat_messages 'store the user message'
    smartspend.api.trpc.chat.sendMessage -> smartspend.api.modules.ai-kernel 'plan the turn: intent, data needs, clarification'
    smartspend.api.modules.ai-kernel -> smartspend.api.modules.finance-semantic-layer 'resolve the facts'
    smartspend.api.modules.ai-kernel -> smartspend.api.modules.ai-providers 'at most one call, only when the facts need wording'
    smartspend.api.modules.ai-providers -> fireworks 'DeepSeek V4 Flash on Fireworks unless an admin sets another chatbot model'
    smartspend.api.trpc.chat.sendMessage -> smartspend.api.modules.ai-actions 'draft an action for confirmation'
    smartspend.api.modules.ai-actions -> smartspend.mysql.ai_pending_actions 'pending action'
    smartspend.web.pages.AICenter <- smartspend.api.trpc.chat.sendMessage 'answer, artifacts and any draft action'
    smartspend.web.pages.AICenter -> smartspend.api.trpc.chat.confirmAction 'user confirms the draft'
    smartspend.api.trpc.chat.confirmAction -> smartspend.api.modules.ai-actions 'execute the confirmed action'
    smartspend.api.modules.ai-actions -> smartspend.mysql.expenses 'for example, record an expense'
  }
}
