// Hand-written flow. scripts/knowledge/flows-rules.ts (run by the tests and by npm run agent:finish) fails
// when a step here is not backed by a relationship generated from the code. Write one step per line with full
// element names; end a step the code cannot show (a human action) with `// intent: <why>`.
views {
  dynamic view flow_sms_ingest {
    title 'Flow · a bank message forwarded from a phone'
    description 'The Android companion or an iOS Shortcut posts message text with the user’s webhook token. The route resolves the token, stores the raw message, parses it with the rule parser and falls back to the AI parser, then writes the transaction, its rollup delta and the raw message status in one database transaction.'

    androidSms -> smartspend.api.http.post_sms_ingest 'POST the notification text with the webhook token'
    smartspend.api.http.post_sms_ingest -> smartspend.mysql.webhook_tokens 'resolve the token to a user'
    smartspend.api.http.post_sms_ingest -> smartspend.mysql.raw_sms_events 'store the raw message'
    smartspend.api.http.post_sms_ingest -> smartspend.api.modules.ingestion-parsers 'rule parser first, AI parser when the rules cannot read it'
    smartspend.api.modules.ingestion-parsers -> gemini 'AI parse'
    smartspend.api.http.post_sms_ingest -> smartspend.mysql.expenses 'insert the transaction'
    smartspend.api.http.post_sms_ingest -> smartspend.api.modules.ledger 'rollup delta'
    smartspend.api.modules.ledger -> smartspend.mysql.expense_daily_rollups 'upsert the day'
  }
}
