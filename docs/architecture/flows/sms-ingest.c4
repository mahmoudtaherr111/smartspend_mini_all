// Hand-written flow. scripts/knowledge/flows-rules.ts (run by the tests and by npm run agent:finish) fails
// when a step here is not backed by a relationship generated from the code. Write one step per line with full
// element names; end a step the code cannot show (a human action) with `// intent: <why>`.
views {
  dynamic view flow_sms_ingest {
    title 'Flow · a bank message forwarded from a phone'
    description 'The Android companion or an iOS Shortcut posts message text with the user’s webhook token. The route resolves the token, refuses a duplicate, stores the raw message and parses it with the rule parser, falling back to the AI parser. Within the plan’s monthly limit it files the message (a known merchant takes its category) and writes the transaction, its rollup delta and the raw message status in one database transaction. Past the limit the rules alone read it and the raw message is kept as a suggestion the user confirms from the home screen.'

    androidSms -> smartspend.api.http.post_sms_ingest 'POST the notification text with the webhook token'
    smartspend.api.http.post_sms_ingest -> smartspend.mysql.webhook_tokens 'resolve the token to a user'
    smartspend.api.http.post_sms_ingest -> smartspend.mysql.raw_sms_events 'store the raw message'
    smartspend.api.http.post_sms_ingest -> smartspend.api.modules.ingestion-parsers 'rule parser first, AI parser when the rules cannot read it; file the message'
    smartspend.api.modules.ingestion-parsers -> gemini 'AI parse'
    smartspend.api.modules.ingestion-parsers -> smartspend.mysql.expenses 'insert the transaction'
    smartspend.api.modules.ingestion-parsers -> smartspend.api.modules.ledger 'rollup delta'
    smartspend.api.modules.ledger -> smartspend.mysql.expense_daily_rollups 'upsert the day'
    smartspend.api.http.post_sms_ingest -> smartspend.mysql.raw_sms_events 'mark it processed, or keep it as a suggestion past the monthly limit'
  }
}
