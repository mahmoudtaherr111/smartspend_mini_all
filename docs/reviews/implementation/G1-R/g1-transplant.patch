+/**
+ * Runs the offline quality corpus and writes a comparable report.
+ *
+ *   npx tsx scripts/classification-core-report.ts [--out <path>] [--baseline <path>] [--details <path>]
+ *
+ * The classifier is not touched. This spawns the existing quality test with
+ * `CLASSIFY_CORE_EVIDENCE_PATH` set — the same run the gate performs — then hands the
+ * evidence it writes to `buildCoreReport`. Nothing here re-scores or re-aligns anything;
+ * a reporting layer that disagrees with the gate is worse than no report.
+ *
+ * Two artefacts, deliberately separate:
+ *
+ *   --out      the summary. Metric names, category names, integers. No transaction text,
+ *              no person names, no keys. This is the one that is safe to paste anywhere,
+ *              and it is the default.
+ *   --details  the raw evidence, opt-in. It contains every fixture sentence and every
+ *              produced row. These fixtures are synthetic, but the same generator points
+ *              at real corpora, so it is never written unless asked for.
+ */
+import { createHash } from "node:crypto";
+import { spawnSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { tmpdir } from "node:os";
+import {
+  buildCoreReport,
+  type CoreEvidence,
+  type CoreReportMetrics,
+} from "../api/qa/classification-core-report";
+
+/** In-scope files whose content can move a metric. Hashed so a change is attributable. */
+const SCOPE_FILES = [
+  "api/lib/smart-pipeline.ts",
+  "api/lib/financial-event-plan.ts",
+  "api/lib/final-acceptance.ts",
+  "api/lib/classification-merge.ts",
+  "api/lib/classifier-contract.ts",
+  "api/lib/confidence-calibrator.ts",
+  "api/lib/confidence-calibration.generated.ts",
+  "api/lib/post-classifier-verifier.ts",
+  "api/lib/rule-engine.ts",
+  "api/lib/entity-extractor.ts",
+  "api/lib/arabic-number-parser.ts",
+  "api/lib/negation-detector.ts",
+  "api/lib/normalizer-v2.ts",
+  "api/lib/text-normalizer.ts",
+  "api/qa/classification-scorer.ts",
+  "api/qa/classification-system-metrics.ts",
+];
+
+const QUALITY_TEST = "api/lib/financial-event-quality.test.ts";
+
+function sha256(input: string): string {
+  return createHash("sha256").update(input).digest("hex");
+}
+
+function arg(name: string): string | undefined {
+  const index = process.argv.indexOf(`--${name}`);
+  return index >= 0 ? process.argv[index + 1] : undefined;
+}
+
+function hashScopeFiles(root: string): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (const file of SCOPE_FILES) {
+    try {
+      out[file] = sha256(readFileSync(resolve(root, file), "utf8"));
+    } catch {
+      // A file that does not exist in this checkout is reported as absent rather than
+      // silently omitted: which files were hashed is part of the provenance.
+      out[file] = "absent";
+    }
+  }
+  return out;
+}
+
+function writeJson(path: string, value: unknown): void {
+  mkdirSync(dirname(resolve(path)), { recursive: true });
+  writeFileSync(resolve(path), `${JSON.stringify(value, null, 2)}\n`, "utf8");
+}
+
+function main(): number {
+  const root = resolve(import.meta.dirname, "..");
+  const outPath = arg("out") || "docs/reviews/implementation/G1/classification-core-report.json";
+  const detailsPath = arg("details");
+  const baselinePath = arg("baseline");
+
+  const scratch = mkdtempSync(resolve(tmpdir(), "classify-core-"));
+  const evidencePath = resolve(scratch, "evidence.json");
+
+  // Resolved from node_modules rather than through `npx`.
+  //
+  // The npx shim is a .cmd on Windows, which spawnSync cannot execute without a shell,
+  // and the failure surfaces as `status: null` — indistinguishable, from the caller's
+  // side, from the gate itself failing. Pointing at vitest's own entry point removes
+  // both the shell dependency and the ambiguity.
+  const vitestBin = resolve(root, "node_modules/vitest/vitest.mjs");
+  const startedAt = Date.now();
+  const run = spawnSync(
+    process.execPath,
+    [vitestBin, "run", QUALITY_TEST, "--reporter=dot"],
+    {
+      cwd: root,
+      stdio: "inherit",
+      env: { ...process.env, CLASSIFY_CORE_EVIDENCE_PATH: evidencePath },
+    },
+  );
+  const runtimeMs = Date.now() - startedAt;
+
+  if (run.error) {
+    console.error(`[core-report] could not start vitest: ${run.error.message}`);
+    rmSync(scratch, { recursive: true, force: true });
+    return 1;
+  }
+
+  if (run.status !== 0) {
+    // The gate failing is the answer. Reporting over a failed run would put numbers
+    // next to a red build and invite someone to quote them.
+    //
+    // `status` is null when the child was killed by a signal rather than exiting, so it
+    // says so instead of printing "exit null" at someone.
+    const how =
+      run.status === null ? `killed by ${run.signal || "a signal"}` : `exit ${run.status}`;
+    console.error(`\n[core-report] quality gate failed (${how}). No report written.`);
+    rmSync(scratch, { recursive: true, force: true });
+    return run.status ?? 1;
+  }
+
+  let evidence: CoreEvidence;
+  try {
+    evidence = JSON.parse(readFileSync(evidencePath, "utf8")) as CoreEvidence;
+  } catch (err) {
+    console.error(
+      `[core-report] the quality run passed but wrote no evidence to ${evidencePath}: ${
+        (err as Error).message
+      }`,
+    );
+    rmSync(scratch, { recursive: true, force: true });
+    return 1;
+  }
+
+  const fixtureSha256 = sha256(
+    JSON.stringify(evidence.rows.map((row) => row.case)),
+  );
+
+  let baseline: { metrics: CoreReportMetrics; fixtureSha256: string } | null = null;
+  if (baselinePath) {
+    try {
+      const previous = JSON.parse(readFileSync(resolve(baselinePath), "utf8")) as {
+        headline?: { candidate?: CoreReportMetrics };
+        provenance?: { fixtureSha256?: string };
+      };
+      if (previous.headline?.candidate && previous.provenance?.fixtureSha256) {
+        baseline = {
+          metrics: previous.headline.candidate,
+          fixtureSha256: previous.provenance.fixtureSha256,
+        };
+      } else {
+        console.warn(`[core-report] ${baselinePath} is not a report; ignoring it.`);
+      }
+    } catch (err) {
+      console.warn(`[core-report] could not read baseline: ${(err as Error).message}`);
+    }
+  }
+
+  const report = buildCoreReport({
+    evidence,
+    baseline,
+    provenance: {
+      fixtureSha256,
+      sourceSha256: hashScopeFiles(root),
+      mode: evidence.mode || "offline",
+      generatedAt: new Date().toISOString(),
+      runtimeMs,
+      node: process.version,
+      settings: {
+        command: `vitest run ${QUALITY_TEST}`,
+        provider: "none — executeLlmChain throws in this run",
+        database: "mocked",
+        userPlan: "free",
+      },
+    },
+  });
+
+  writeJson(outPath, report);
+  if (detailsPath) writeJson(detailsPath, evidence);
+  rmSync(scratch, { recursive: true, force: true });
+
+  const { candidate, delta } = report.headline;
+  const unsafe = report.decisions.unsafeAutoSaves;
+  console.log(`\n[core-report] ${outPath}`);
+  console.log(`  cases                ${candidate.cases}`);
+  console.log(
+    `  record triple F1     ${candidate.tripleF1.toFixed(4)}${
+      delta ? ` (${delta.tripleF1! >= 0 ? "+" : ""}${delta.tripleF1!.toFixed(4)})` : " (no baseline)"
+    }`,
+  );
+  console.log(`  amount F1            ${candidate.amountF1.toFixed(4)}`);
+  console.log(
+    `  unsafe auto-saves    ${unsafe.count} — ${(unsafe.ofAllCases.rate * 100).toFixed(2)}% of ` +
+      `${unsafe.ofAllCases.denominator} cases, ${
+        unsafe.ofAutoSavedCases.rate === null
+          ? "n/a"
+          : `${(unsafe.ofAutoSavedCases.rate * 100).toFixed(2)}%`
+      } of ${unsafe.ofAutoSavedCases.denominator} auto-saved`,
+  );
+  for (const warning of report.warnings) console.log(`  ! ${warning}`);
+  if (detailsPath) console.log(`  details (synthetic fixtures) -> ${detailsPath}`);
+  return 0;
+}
+
+process.exit(main());
