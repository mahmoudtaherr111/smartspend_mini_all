{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/session-start.mjs",
            "statusMessage": "Checking SmartSpend sync status",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/stop.mjs",
            "statusMessage": "Checking SmartSpend knowledge rules",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
