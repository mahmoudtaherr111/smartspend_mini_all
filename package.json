{
  "name": "smartspend-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild api/boot.ts --platform=node --bundle --format=esm --outdir=dist --external:@sentry/* --external:@sentry-internal/* --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "backend:dev": "tsx watch api/server.ts",
    "backend:build": "esbuild api/server.ts --platform=node --bundle --format=esm --outdir=dist/server --external:@sentry/* --external:@sentry-internal/* --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "backend:start": "NODE_ENV=production node dist/server/server.js",
    "frontend:dev": "vite --mode frontend",
    "frontend:build": "vite build --mode frontend"
  },
