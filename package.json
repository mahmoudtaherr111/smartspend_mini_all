{
  "name": "smartspend-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production vite build --mode production && esbuild api/boot.ts --platform=node --bundle --format=esm --outdir=dist --external:@sentry/* --external:@sentry-internal/* --external:node-cron --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:redis": "cross-env RUN_REDIS_INTEGRATION=1 vitest run api/lib/redis-client.integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --project='iPhone 14' --project='Android Chrome Pixel 7'",
    "test:all": "npm run check && npm run test && npm run test:e2e",
    "qa:seed": "tsx api/qa/ai-center-qa-seed.ts",
    "qa:ai-center": "tsx api/qa/ai-center-qa-runner.ts",
    "bench:classify": "cross-env CLASSIFY_BENCH_REPORT=1 vitest run api/lib/classification-benchmark.test.ts",
    "bench:classify:live": "tsx api/qa/classification-benchmark-runner.ts --mode=live",
    "bench:classify:freeze": "tsx api/qa/classification-baseline.ts --freeze",
    "bench:classify:compare": "tsx api/qa/classification-baseline.ts --compare",
    "qa:ai-center:full": "npm run qa:ai-center",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "backend:dev": "tsx watch api/server.ts",
    "backend:build": "esbuild api/server.ts --platform=node --bundle --format=esm --outdir=dist/server --external:@sentry/* --external:@sentry-internal/* --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "backend:start": "NODE_ENV=production node dist/server/server.js",
    "frontend:dev": "vite --mode frontend",
    "frontend:build": "cross-env NODE_ENV=production vite build --mode frontend",
    "cap:sync": "tsx scripts/sync-capacitor-assets.ts"
  },
