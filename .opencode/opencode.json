{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "smartspend",
  "instructions": [
    "AGENTS.md",
    "smartspend_architecture_plan.md",
    "smartspend_system_context.md"
  ],
  "references": {
    "docs": {
      "path": "docs",
      "description": "Project documentation for SmartSpend AI"
    },
    "contracts": {
      "path": "contracts",
      "description": "Shared type contracts between frontend and API"
    },
    "db-schema": {
      "path": "db",
      "description": "Database schema and migrations (Drizzle ORM)"
    }
  },
  "permission": {
    "external_directory": {
      "*": "allow"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    }
  }
}
